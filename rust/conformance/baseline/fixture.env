# Synthetic fixture values for the local conformance baseline. None of these
# protect anything: the baseline binds to loopback, holds generated sample data,
# and is wiped on every reset. Never reuse them on a real deployment.
#
# Sourced by the scripts in ../scripts and by the comparison harness.

# Compose project and loopback host ports. All are overridable from the
# environment; start.sh refuses a port another process already holds.
CONF_PROJECT=${CONF_PROJECT:-silo-conformance}
CONF_PG_PORT=${CONF_PG_PORT:-25432}
CONF_REDIS_PORT=${CONF_REDIS_PORT:-26379}
CONF_API_PORT=${CONF_API_PORT:-28080}
CONF_JF_PORT=${CONF_JF_PORT:-28096}
CONF_ABS_PORT=${CONF_ABS_PORT:-28378}
CONF_METRICS_PORT=${CONF_METRICS_PORT:-29090}

# Fixed so at-rest encryption and JWT signing stay stable across resets.
CONF_SECRET_KEY=conformance-fixture-master-key-not-a-secret-000000
CONF_JWT_SECRET=Y29uZm9ybWFuY2UtZml4dHVyZS1qd3Qtc2VjcmV0LTA=

CONF_ADMIN_USERNAME=conf-admin
CONF_ADMIN_PASSWORD=conformance-admin-password
CONF_ADMIN_PROFILE_ID=c0f00000-0000-4000-8000-000000000001
CONF_ADMIN_API_KEY=sa_c0fa000000000000000000000000000000000000000000000000000000000001

CONF_USER_USERNAME=conf-user
CONF_USER_PASSWORD=conformance-user-password
CONF_USER_PROFILE_ID=c0f00000-0000-4000-8000-000000000002
CONF_USER_SECOND_PROFILE_ID=c0f00000-0000-4000-8000-000000000003
CONF_USER_API_KEY=sa_c0fb000000000000000000000000000000000000000000000000000000000002
